(** A [GtkStatusbar] widget is usually placed along the bottom of an
    application's main [Gtk.Window].

    Its methods, signals and properties are on {!class-type-statusbar_t}. Its
    full description is under {!section-description}. Its constructors are under
    {!section-constructors}. The functions it is built on are in
    {!Ocgtk.Raw.Statusbar}. *)

(** {1:class Class} *)

(** {b The methods, signals and properties of a [Statusbar].}

    Inherits from: {{!Ocgtk.Widget.class-type-widget_t}Ocgtk.Widget}

    Implements:
    - {{!Ocgtk.Accessible.class-type-accessible_t}Ocgtk.Accessible}
    - {{!Ocgtk.Buildable.class-type-buildable_t}Ocgtk.Buildable}
    - {{!Ocgtk.Constraint_target.class-type-constraint_target_t}Ocgtk.Constraint_target}

    A [GtkStatusbar] widget is usually placed along the bottom of an
    application's main [Gtk.Window].

    An example GtkStatusbar

    A [GtkStatusBar] may provide a regular commentary of the application's
    status (as is usually the case in a web browser, for example), or may be
    used to simply output a message when the status changes, (when an upload is
    complete in an FTP client, for example).

    Status bars in GTK maintain a stack of messages. The message at the top of
    the each bar’s stack is the one that will currently be displayed.

    Any messages added to a statusbar’s stack must specify a context id that is
    used to uniquely identify the source of a message. This context id can be
    generated by [Gtk.Statusbar.get_context_id], given a message and the
    statusbar that it will be added to. Note that messages are stored in a
    stack, and when choosing which message to display, the stack structure is
    adhered to, regardless of the context identifier of a message.

    One could say that a statusbar maintains one stack of messages for display
    purposes, but allows multiple message producers to maintain sub-stacks of
    the messages they produced (via context ids).

    Status bars are created using [Gtk.Statusbar.new].

    Messages are added to the bar’s stack with [Gtk.Statusbar.push].

    The message at the top of the stack can be removed using
    [Gtk.Statusbar.pop]. A message can be removed from anywhere in the stack if
    its message id was recorded at the time it was added. This is done using
    [Gtk.Statusbar.remove].

    {b CSS node}

    [GtkStatusbar] has a single CSS node with name [statusbar]. *)
class type statusbar_t = object
  inherit
    Event_controller_and__layout_child_and__layout_manager_and__root_and__tooltip_and__widget
    .widget_t

  (** {2:signals Signals} *)

  method on_text_popped :
    ?after:bool ->
    callback:(context_id:int -> text:string -> unit) ->
    unit ->
    Gobject.Signal.handler_id
  (** Emitted whenever a new message is popped off a statusbar's stack. *)

  method on_text_pushed :
    ?after:bool ->
    callback:(context_id:int -> text:string -> unit) ->
    unit ->
    Gobject.Signal.handler_id
  (** Emitted whenever a new message gets pushed onto a statusbar's stack. *)

  (** {2:methods Methods} *)

  method get_context_id : string -> int
  (** Returns a new context identifier, given a description of the actual
      context.

      Note that the description is not shown in the UI. *)

  method pop : int -> unit
  (** Removes the first message in the [GtkStatusbar]’s stack with the given
      context id.

      Note that this may not change the displayed message, if the message at the
      top of the stack has a different context id. *)

  method push : int -> string -> int
  (** Pushes a new message onto a statusbar’s stack. *)

  method remove : int -> int -> unit
  (** Forces the removal of a message from a statusbar’s stack. The exact
      [context_id] and [message_id] must be specified. *)

  method remove_all : int -> unit
  (** Forces the removal of all messages from a statusbar's stack with the exact
      [context_id]. *)

  (** {2:conversions Conversions} *)

  method as_statusbar : Raw.Statusbar.t
end

class statusbar : Raw.Statusbar.t -> statusbar_t
(** Wraps a raw handle of {!Ocgtk.Raw.Statusbar.t}. *)

