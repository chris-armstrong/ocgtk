{%html: <script type="module">
import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@12.1.0/dist/mermaid.esm.min.mjs';
mermaid.initialize({ startOnLoad: false, theme: 'neutral' });
// Render each {@mermaid[...]} block with its own id. mermaid.run() derives
// ids from Date.now(), so diagrams rendered in the same millisecond collide.
let n = 0;
for (const code of document.querySelectorAll('pre.language-mermaid > code')) {
  const { svg } = await mermaid.render(`ocgtk-diagram-${n++}`, code.textContent);
  const div = document.createElement('div');
  div.className = 'ocgtk-diagram';
  div.innerHTML = svg;
  code.parentElement.replaceWith(div);
}
</script> %}
