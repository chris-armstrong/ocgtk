    GIO.
    @since 2.30 *)

val power_profile_monitor_extension_point_name : string
(** Extension point for power profile usage monitoring functionality. See
    Extending GIO.
    @since 2.70 *)

val proxy_extension_point_name : string
(** Extension point for proxy functionality. See Extending GIO.
    @since 2.26 *)

val proxy_resolver_extension_point_name : string
(** Extension point for proxy resolving functionality. See Extending GIO. *)

val settings_backend_extension_point_name : string
(** Extension point for [GSettingsBackend] functionality. *)

val tls_backend_extension_point_name : string
(** Extension point for TLS functionality via [GTlsBackend]. See Extending GIO.
*)

val tls_database_purpose_authenticate_client : string
