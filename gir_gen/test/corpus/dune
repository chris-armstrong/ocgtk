; Cross-namespace reference files for the signal corpus.
;
; Each rule invokes [gir_gen references] over one namespace's GIR + override
; file and the references files of its dependencies, producing the same
; [*-references.sexp] artefact that the production bindings generator
; consumes in [scripts/generate-bindings.sh]; the dependencies match its DEPS
; table. The corpus test loads all nine files at runtime so signal
; classification sees the same cross-namespace knowledge the real generator
; does — without them, every cross-namespace type would fall off to
; [Tk_Unknown] and the baseline would over-report skips.
;
; Loading a namespace logs every skipped member, so both output streams go to
; %{null}; rerun a failing rule's command by hand to see its error.

(rule
 (target cairo-references.sexp)
 (deps
  (:gir_gen ../../bin/gir_gen.exe)
  (:gir %{workspace_root}/gir/cairo-1.0.gir)
  (:overrides %{workspace_root}/overrides/cairo.sexp))
 (action
  (with-outputs-to
   %{null}
   (run %{gir_gen} references -o %{overrides} %{gir} %{target}))))

(rule
 (target gio-references.sexp)
 (deps
  (:gir_gen ../../bin/gir_gen.exe)
  (:gir %{workspace_root}/gir/Gio-2.0.gir)
  (:overrides %{workspace_root}/overrides/gio.sexp))
 (action
  (with-outputs-to
   %{null}
   (run %{gir_gen} references -o %{overrides} %{gir} %{target}))))

(rule
 (target gdk-references.sexp)
 (deps
  (:gir_gen ../../bin/gir_gen.exe)
  (:gir %{workspace_root}/gir/Gdk-4.0.gir)
  (:overrides %{workspace_root}/overrides/gdk.sexp)
  cairo-references.sexp
  pango-references.sexp
  pangocairo-references.sexp
  gdkpixbuf-references.sexp
  gio-references.sexp)
 (action
  (with-outputs-to
   %{null}
   (run
    %{gir_gen}
    references
    -o
    %{overrides}
    -r
    cairo-references.sexp
    -r
    pango-references.sexp
    -r
    pangocairo-references.sexp
    -r
    gdkpixbuf-references.sexp
    -r
    gio-references.sexp
    %{gir}
    %{target}))))

