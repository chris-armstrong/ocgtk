(** A render node that will fill the area determined by stroking the the given
    {{!Ocgsk.Path.class-type-path_t}[Gsk.Path]} using the
    {{!Ocgsk.Stroke.class-type-stroke_t}[Gsk.Stroke]} attributes.

    Its methods, signals and properties are on {!class-type-stroke_node_t}. Its
    constructors are under {!section-constructors}. The functions it is built on
    are in {!Ocgsk.Raw.Stroke_node}. *)

(** {1:class Class} *)

(** {b The methods, signals and properties of a [StrokeNode].}

    Inherits from:
    {{!Ocgsk.Render_node.class-type-render_node_t}Ocgsk.Render_node}

    A render node that will fill the area determined by stroking the the given
    {{!Ocgsk.Path.class-type-path_t}[Gsk.Path]} using the
    {{!Ocgsk.Stroke.class-type-stroke_t}[Gsk.Stroke]} attributes. *)
class type stroke_node_t = object
  inherit Render_node.render_node_t

  (** {2:methods Methods} *)

  method get_child : unit -> Render_node.render_node_t
  (** Gets the child node that is getting drawn by the given [node]. *)

  method get_path : unit -> Raw.Path.t
  (** Retrieves the path that will be stroked with the contents of the [node].
  *)

  method get_stroke : unit -> Raw.Stroke.t
  (** Retrieves the stroke attributes used in this [node]. *)

  (** {2:conversions Conversions} *)

  method as_stroke_node : Raw.Stroke_node.t
end

class stroke_node : Raw.Stroke_node.t -> stroke_node_t
(** Wraps a raw handle of {!Ocgsk.Raw.Stroke_node.t}. *)

(** {1:constructors Constructors} *)

val new_ :
  Render_node.render_node_t -> Raw.Path.t -> Raw.Stroke.t -> stroke_node_t
(** Creates a {{!Ocgsk.Render_node.class-type-render_node_t}[GskRenderNode]}
    that will fill the outline generated by stroking the given [path] using the
    attributes defined in [stroke].

    The area is filled with [child]. *)
