; Test-only C helpers that invoke GClosures the way GLib's signal
; machinery does

(library
 (name gobject_test_helpers)
 (wrapped false)
 (modules gobject_test_helpers)
 (foreign_stubs
  (language c)
  (names ml_gobject_test_helpers)
  (flags
   -fPIC
   (:include %{project_root}/ocglib/cflag-glib.sexp)))
 (flags
  (:standard -open Ocglib))
 (libraries ocglib))

